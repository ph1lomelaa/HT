BOT_TOKEN=replace_with_botfather_token
# Optional: restrict access to staff Telegram user IDs (comma separated).
ALLOWED_USER_IDS=
# Optional: hide specific months, comma-separated; default shows all accessible months.
# EXCLUDED_PILGRIM_MONTHS=February 2026,December 2025,January 2026
# Default: pligrim_bot/credentials/service_account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service_account.json
# Server alternative: GOOGLE_CREDS=<service account JSON>

# Telegram Mini App and standalone site
WEBAPP_URL=https://voucherhickmet.duckdns.org
# Optional public bot username (without @); otherwise fetched from Telegram
# BOT_USERNAME=your_bot
# Shared writable directory for bot/web login and generated files
# WEB_STATE_DIR=/app/pligrim_bot/data/runtime
# Docker network of the existing Caddy container on the server
CADDY_NETWORK=infra_infra_net
